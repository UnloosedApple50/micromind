# MicroMind Configuration Template
# Copy this file to .env and customize for your environment

# ─────────────────────────────────────────────────────────────
# Core Settings
# ─────────────────────────────────────────────────────────────

# Execution profile: ULTRA_LOW, LEGACY, LOW, STANDARD, HIGH, SERVER
# Default: auto (detect from hardware)
MICROMIND_PROFILE=auto

# Configuration directory
MICROMIND_CONFIG_DIR=./config

# Data directory
MICROMIND_DATA_DIR=./data

# ─────────────────────────────────────────────────────────────
# AI Provider
# ─────────────────────────────────────────────────────────────

# AI provider: no_ai, rule_based, micro_ai, local_llm, remote_api, gateway
# Default: micro_ai
MICROMIND_AI_PROVIDER=micro_ai

# Local LLM settings (for local_llm provider)
MICROMIND_LLM_HOST=http://localhost:11434
MICROMIND_LLM_MODEL=qwen2.5:0.5b

# Remote API settings (for remote_api provider)
MICROMIND_REMOTE_API_URL=
MICROMIND_REMOTE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Gateway
# ─────────────────────────────────────────────────────────────

# Gateway URL (for remote storage, AI, and telephony)
MICROMIND_GATEWAY_URL=

# Gateway API token
MICROMIND_GATEWAY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Telephony
# ─────────────────────────────────────────────────────────────

# Enable telephony: true, false
# Default: false
MICROMIND_TELEPHONY_ENABLED=false

# Telephony provider: gateway, sip, cloud, local_pbx, disabled
# Default: disabled
MICROMIND_TELEPHONY_PROVIDER=disabled

# Call policy: auto_call, confirm_call, block_call
# Default: confirm_call
MICROMIND_CALL_POLICY=confirm_call

# Business hours (24h format, UTC)
MICROMIND_BUSINESS_HOURS_START=9
MICROMIND_BUSINESS_HOURS_END=18

# Rate limits
MICROMIND_MAX_CALLS_PER_HOUR=10
MICROMIND_MAX_CALLS_PER_DAY=50
MICROMIND_COOLDOWN_SECONDS=300

# Budget limits
MICROMIND_DAILY_BUDGET=100.0
MICROMIND_MONTHLY_BUDGET=2000.0

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────

# Enable safe mode (blocks dangerous operations)
# Default: false
MICROMIND_SAFE_MODE=false

# Default permission level: admin, manager, user, read_only, service
# Default: user
MICROMIND_DEFAULT_PERMISSION=user

# ─────────────────────────────────────────────────────────────
# Automation
# ─────────────────────────────────────────────────────────────

# Enable automation engine
# Default: true
MICROMIND_AUTOMATION_ENABLED=true

# Maximum automation rules
# Default: 100
MICROMIND_MAX_RULES=100

# Maximum recursion depth
# Default: 5
MICROMIND_MAX_DEPTH=5

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────

# Log level: debug, info, warning, error, critical
# Default: info
MICROMIND_LOG_LEVEL=info

# Log file (leave empty for stdout only)
MICROMIND_LOG_FILE=

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────

# Storage backend: flatfile, sqlite, remote
# Default: flatfile (ULTRA_LOW/LEGACY) or sqlite (LOW+)
MICROMIND_STORAGE_BACKEND=auto

# ─────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────

# Enable debug mode
# Default: false
MICROMIND_DEBUG=false

# Enable dry run mode (automation actions are logged but not executed)
# Default: false
MICROMIND_DRY_RUN=false
